{
  "name": "@headscale-admin/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/db',{recursive:true});fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "node --env-file-if-exists=.env --import tsx src/db/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.2.1",
    "jose": "^6.0.10",
    "openid-client": "^6.3.4",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "undici": "^7.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
