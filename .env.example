# ============================================================================
# headscale-admin 环境变量模板
# ============================================================================
#
# 用法：
#   cp .env.example .env
#   chmod 600 .env                 # 里面是生产密钥，必须收紧权限
#   填「二、必填项」4 个值 → docker compose up -d
#
# ⚠️ .env 已在 .gitignore 中，绝不要提交到版本库。
# ⚠️ 本模板不含任何真实密钥。密钥项刻意留空 —— 带默认值的密钥会让人忘记改，
#    最后变成「所有部署实例同一个密钥」。
#
# 两种运行方式的差异（本文档以 docker compose 生产部署为主）：
#
#   docker compose：密钥**必填**，缺失直接启动失败（compose 里做了 ${VAR:?} 校验）
#   裸进程 (npm start)：密钥可留空，首次启动自动生成到 $PANEL_DATA_DIR/*.key
#
# 章节索引
#   一、部署场景选择（决定 COMPOSE_FILE）        ★ 先看这里
#   二、必填项（4 个）                           ★ 缺一即启动失败
#   三、对接 headscale 的五种拓扑                ★ 重点
#   四、面板自身
#   五、节点状态采样
#   六、安全与会话
#   七、时序库 InfluxDB 3.x（可选）
#   八、DNS extra-records（可选）
#   九、容器与构建期参数
#   十、完整配置示例（两套，可直接抄）           ★ 最后一节


# ============================================================================
# 一、部署场景选择
# ============================================================================
#
# Compose 会读本文件里的 COMPOSE_FILE，自动决定叠加哪些 overlay。
# 设好后日常只需 `docker compose up -d` / `down` / `logs`，不必每次写 -f。
#
# 三个编排文件的职责：
#   docker-compose.yml             面板（核心，唯一必需）
#   docker-compose.headscale.yml   headscale（可选：本机没有、要一起跑时叠加）
#   docker-compose.metrics.yml     InfluxDB 3.x（可选：要历史曲线时叠加）
#
# ⚠️ 路径分隔符：Linux/macOS 用 `:`，Windows 用 `;`
# ⚠️ 切换场景前先 `docker compose down`，否则会操作到另一组容器上
#
# ---- 场景 ①：对接已有的生产 headscale（最常见，默认走这条）----
COMPOSE_FILE=docker-compose.yml
#
# ---- 场景 ②：一体化，面板 + headscale 一起跑（新建环境 / 测试 / 小规模）----
# ⚠️ 场景 ② 还要把下面的 HS_URL 改成 http://headscale:8080（同 compose 的服务名）。
#    Compose 的变量插值在每个文件解析时就发生，overlay 无法替你补默认值 ——
#    不写 HS_URL 会直接报 required variable HS_URL is missing。
# COMPOSE_FILE=docker-compose.yml:docker-compose.headscale.yml
#
# ---- 场景 ③：对接已有 headscale + 时序库 ----
# COMPOSE_FILE=docker-compose.yml:docker-compose.metrics.yml
#
# ---- 场景 ④：一体化 + 时序库 ----
# COMPOSE_FILE=docker-compose.yml:docker-compose.headscale.yml:docker-compose.metrics.yml
#
# 不用 COMPOSE_FILE 也行，显式指定等价：
#   docker compose -f docker-compose.yml -f docker-compose.headscale.yml up -d


# ============================================================================
# 二、必填项（4 个，缺一即启动失败）
# ============================================================================

# ---- 2.1 加密主密钥 ----
# 作用：AES-256-GCM 加密库里的敏感设置（headscale API Key、TOTP 密钥、
#       OIDC 私钥、时序库 token）。界面只回显掩码。
# 格式：64 位十六进制（**不是** base64）
# 生成：openssl rand -hex 32
#
# ⚠️ 设定后**不可更改** —— 换了之后旧密文全部解不开（面板会把已存的
#    headscale API Key 当成乱码，表现为「所有操作 401」）。
#    改之前必须备份 master.key，或接受重新录入所有密钥。
# ⚠️ 裸进程模式下留空会自动生成到 PANEL_DATA_DIR/master.key（权限 600）
#    并一直复用；compose 模式下留空直接启动失败。
PANEL_MASTER_KEY=

# ---- 2.2 会话签名密钥 ----
# 作用：签发登录会话 Cookie。
# 格式：64 位十六进制
# 生成：openssl rand -hex 32
# 轮换的影响：所有已登录用户被踢下线，重新登录即可，数据不受影响。
PANEL_SESSION_SECRET=

# ---- 2.3 面板对外地址 ----
# 作用：(a) 生成跳转链接与 Cookie 的 Secure 判断
#       (b) **作为内置 OIDC Provider 的 issuer**
# 格式：协议 + 域名 [+ 端口]，结尾不要加斜杠
#
# ⚠️ 必须与浏览器地址栏**完全一致**。不一致的后果：
#    · 单点登录时 headscale 侧 iss 校验失败，登不进去
#    · 登录后跳到错误域名
#    最常见错误：实际用 https 访问但这里写了 http；
#    或反代在 8443 端口但这里漏了端口。
#
# 本地试用：  http://127.0.0.1:3000
# 生产：      https://hs-admin.example.com
PANEL_PUBLIC_URL=https://hs-admin.example.com

# ---- 2.4 Headscale API Key ----
# 作用：面板读写 headscale 的唯一凭据。
# 格式：hskey-api-xxxxxxxx_xxxxxxxx...（约 87 字符）
#
# 生成方式（在 headscale 所在环境执行）：
#   容器部署：  docker exec headscale headscale apikeys create --expiration 999d
#   二进制部署：headscale apikeys create --expiration 999d
#
# ⚠️ 明文只显示这一次，没记下只能重建。
# ⚠️ 有效期按需。设短更安全，但要记住续期，否则某天面板会全部 401
#    （现象：所有操作都失败，但面板本身是好的，很容易误判成面板 bug）。
HS_API_KEY=


# ============================================================================
# 三、对接 headscale 的五种拓扑   ★ 重点
# ============================================================================
#
# 面板不关心 headscale 跑在哪，只要求「从**面板容器内部**能访问到 HS_URL」。
# 选一种填 HS_URL 即可。
#
# 填完先自测，别等面板报错再猜（panel 起来后执行）：
#   docker compose exec panel node -e \
#     "fetch(process.env.HS_URL+'/health').then(r=>console.log('HTTP',r.status)).catch(e=>console.log('失败',e.message))"
#
#   200              = 通
#   ECONNREFUSED     = 端口不通（headscale 没监听 / 防火墙 / 只绑了 127.0.0.1）
#   ENOTFOUND        = 域名解析不了（容器内 DNS 问题，或用了容器外的别名）
#   证书错误          = 见拓扑 ⑤
#
# ---- 拓扑 ①：同一 compose（一体化，场景 ②）----
# 用服务名直连，走 compose 内部网络，完全不经过宿主机。
HS_URL=http://headscale:8080
#
# ---- 拓扑 ②：headscale 是另一个 compose 项目的容器 ----
# (a) 加入同一个 Docker 网络（推荐：走内部 DNS，不暴露端口）
#     对方 compose 里给它固定网络名（不加 name 会带项目前缀）：
#         networks:
#           hs-shared:
#             name: hs-shared
#     本项目 docker-compose.yml 的 panel 接到该网络：
#         networks:
#           hs-shared:
#             external: true
#     然后：
# HS_URL=http://headscale:8080
#
# (b) 走宿主机端口映射（简单，多一跳）
#     要求对方把端口发布到宿主：ports: ["127.0.0.1:8080:8080"]
# HS_URL=http://host.docker.internal:8080
#
# ---- 拓扑 ③：headscale 是宿主机二进制（systemd 直接跑）----
# 用 host.docker.internal（compose 已加 extra_hosts: host-gateway）。
# ⚠️ headscale 必须监听 0.0.0.0 或 docker0 网桥地址；
#    只监听 127.0.0.1 时容器访问不到。检查：ss -tlnp | grep 8080
# HS_URL=http://host.docker.internal:8080
#
# ---- 拓扑 ④：局域网另一台机器 ----
# 直接 IP + 端口。⚠️ 确认对端防火墙放通了**面板所在宿主机**的源地址。
# HS_URL=http://192.168.1.50:8080
#
# ---- 拓扑 ⑤：域名 + TLS（生产推荐）----
# 面板会正常校验上游证书，用受信证书时无需任何额外配置：
# HS_URL=https://hs.example.com
#
# 仅当对方是**自签名证书**时才考虑关校验（不推荐）：
#   HS_TLS_SKIP_VERIFY=true
# 更好的做法：给 headscale 换受信证书，或把内部 CA 装进面板容器。

# ---- 当前选用的拓扑（必填，无默认值）----
# 下面按「对接宿主机上的 headscale」占位，按你的实际拓扑替换成上面任一种。
# ⚠️ 这行不能删：面板启动时会校验它存在，缺失直接失败。
HS_URL=http://host.docker.internal:8080

# 传输方式：rest = /api/v1/*（推荐，v0.26+ 足够）
#           grpc = 直连 :50443（仅在需要 gRPC 独有能力时）
HS_TRANSPORT=rest
# gRPC 地址，仅 HS_TRANSPORT=grpc 时使用
HS_GRPC_ADDR=127.0.0.1:50443
# 单次请求超时（毫秒）
HS_TIMEOUT_MS=10000
# 跳过上游 TLS 证书校验（自签证书场景；生产不建议）
HS_TLS_SKIP_VERIFY=false


# ============================================================================
# 四、面板自身
# ============================================================================

# 监听地址（容器内固定 0.0.0.0，由 compose 覆盖，裸进程部署时才需要改）
PANEL_HOST=127.0.0.1
# 面板 HTTP 端口。compose 里容器内固定 3000，对外端口看下面的 PANEL_PORT。
PANEL_PORT=3000

# 面板数据目录：SQLite（账号/ACL/审计）+ master.key + session.key
# compose 里固定 /data 并挂到 panel-data 卷，安全加固依赖这个路径。
PANEL_DATA_DIR=./data

# 初始管理员。仅**首次启动**（用户表为空时）播种，之后在界面里管理。
PANEL_ADMIN_USER=admin
# 初始口令。留空则随机生成并打印在容器日志里（推荐，避免明文留在 .env）
# 生成：openssl rand -base64 24
PANEL_ADMIN_SECRET=

# 运行环境与日志级别
# NODE_ENV：development | production
NODE_ENV=production
# LOG_LEVEL：trace|debug|info|warn|error
LOG_LEVEL=info

# 前端静态资源目录。默认相对模块位置（容器内是 /app/web/dist），
# 只有把产物挪到别处时才需要显式指定。
# WEB_DIST=


# ============================================================================
# 五、节点状态采样
# ============================================================================
# 面板定期拉 headscale 的节点列表，据此计算在线状态与在线时长。
# 采样间隔 = 时长统计精度：15s 间隔意味着单次误差最大 ±15s。

POLL_ENABLED=true
POLL_INTERVAL_SEC=15


# ============================================================================
# 六、安全与会话
# ============================================================================

# 登录失败锁定（防暴力破解）：窗口内失败达到 N 次即锁定
LOGIN_MAX_FAILURES=5
# 锁定时长（秒）
LOGIN_LOCKOUT_SEC=900

# 登录接口限流：窗口内允许的**总尝试次数**（含成功）
# ⚠️ 数的是总尝试数，不是失败数。自动化测试连跑会撞，
#    本地联调建议放宽到 300，生产保持 20。
LOGIN_RATE_MAX=20
LOGIN_RATE_WINDOW_SEC=300

# 会话有效期（秒），默认 12 小时
SESSION_TTL_SEC=43200

# 写操作 CSRF 校验。生产**必须** true
CSRF_ENABLED=true


# ============================================================================
# 七、时序库 InfluxDB 3.x（可选）
# ============================================================================
# 不启用：留空即可，统计降级为「无时序库」，趋势图与在线时长不可用，
#         但设备 / 用户 / ACL / 路由 / DNS / OIDC 等核心功能完全不受影响。
#
# 启用步骤（3.x 没有 2.x 那套 INIT 自动初始化，admin token 要手工建一次）：
#   1) docker compose -f docker-compose.yml -f docker-compose.metrics.yml \
#                     --profile metrics up -d influxdb
#   2) curl -X POST http://127.0.0.1:8086/api/v3/configure/token/admin
#      → 取返回 JSON 里的 token 字段（形如 apiv3_xxx，长度 92）
#   3) 填下面三项 → docker compose up -d panel
#
# ⚠️ 3.x 与 2.x 不兼容：端口 8181、无 org 概念、查询用 SQL（Flux 已移除）。
#    从 2.x 升上来的历史数据**不会迁移**（存储格式不同）。

# 面板连接地址。容器内端口是 8181（不是 2.x 的 8086）。
# 不启用时序库时保持注释状态。
# INFLUX_URL=http://influxdb:8181
# database 名（2.x 叫 bucket）。不存在时首次写入自动创建。
INFLUX_BUCKET=headscale_admin
# admin token，格式 apiv3_...
INFLUX_TOKEN=
# 3.x 已废弃 org；保留只为兼容旧 .env，不参与任何请求
INFLUX_ORG=headscale


# ============================================================================
# 八、DNS extra-records（可选）
# ============================================================================
# 面板写 JSON 文件、headscale 读（fsnotify 监听，写文件即生效，无需重启）。
#
# ⚠️ 启用前必须让文件先存在，否则 headscale 启动时 stat 失败直接 fatal：
#      echo '[]' > data/dns/extra-records.json
#    并让 headscale 的 config.yaml 里 extra_records_path 指向同一文件。
#
# 面板侧写入路径（**容器内**视角）：
# HS_EXTRA_RECORDS_PATH=/dns/extra-records.json


# ============================================================================
# 九、容器与构建期参数
# ============================================================================

# ---- 容器名（同机跑多套时用来区分）----
PANEL_CONTAINER_NAME=headscale-admin
HS_CONTAINER_NAME=headscale

# ---- 镜像 ----
# 面板镜像。用自己构建的镜像时保持默认；用发布产物时填仓库地址。
PANEL_IMAGE=headscale-admin:1.1.0
# headscale 官方镜像
HEADSCALE_IMAGE=headscale/headscale:v0.29.6
# 时序库镜像（固定补丁版本，不用 3-core / latest 这类浮动 tag）
INFLUX_IMAGE=influxdb:3.12.1-core

# ---- 端口绑定 ----
# 面板：默认只绑回环，由前置 nginx/Caddy 终止 TLS 后反代。
# ⚠️ 改成 0.0.0.0 直接对外**必须**先配好 TLS —— http 明传口令。
PANEL_BIND=127.0.0.1
PANEL_PORT=3000
# headscale 宿主端口（容器内固定 8080）。8080 是超高频占用端口，
# 冲突时会报 `port is already allocated`，改这里即可。
HS_BIND=127.0.0.1
HS_PORT=8080
# 时序库宿主端口（容器内固定 8181）
INFLUX_BIND=127.0.0.1
INFLUX_PORT=8086
# InfluxDB 单机节点标识，容器重建保持不变即可
INFLUX_NODE_ID=node1

# ---- DNS 共享目录（宿主机路径）----
DNS_RECORDS_DIR=./data/dns

# ---- 构建期参数（只在拉不到镜像 / 想加速构建时改）----
# 国内网络常见问题：node 官方镜像与 npm 官方源都慢或超时。改这两项即可：
#   NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
#   NPM_REGISTRY=https://registry.npmmirror.com
#
# ⚠️ NODE_IMAGE **必须带 tag**。不带 tag 会拿到 latest（Debian 版而非 Alpine）：
#    本 Dockerfile 已不依赖包管理器所以能跑，但镜像会大很多。
NODE_IMAGE=node:22-alpine
NPM_REGISTRY=https://registry.npmjs.org

# 面板版本号。留空 = 沿用 package.json 里的版本（推荐）。
# 只在 CI 需要用 git tag 强制对齐时才填。
PANEL_VERSION=

# ---- 时区 ----
TZ=Asia/Shanghai


# ============================================================================
# 十、完整配置示例（可直接抄）
# ============================================================================
#
# ================= 示例 A：一体化部署（面板 + headscale 同机新建）=================
#
#   COMPOSE_FILE=docker-compose.yml:docker-compose.headscale.yml
#   PANEL_MASTER_KEY=<openssl rand -hex 32>
#   PANEL_SESSION_SECRET=<openssl rand -hex 32>
#   PANEL_PUBLIC_URL=https://hs-admin.example.com
#   HS_URL=http://headscale:8080        ← 一体化场景固定是这个
#   HS_API_KEY=<第 3 步创建后回填>
#   HS_PORT=8080
#   PANEL_BIND=127.0.0.1
#   PANEL_PORT=3000
#   TZ=Asia/Shanghai
#
#   步骤：
#     1. 改 config/headscale/config.yaml 的 server_url 与 dns.base_domain
#        （这两项是占位符，不改的话 headscale 起来了但客户端连不上）
#     2. mkdir -p data/dns
#     3. docker compose up -d headscale
#     4. docker compose exec headscale headscale apikeys create --expiration 999d
#        → 把 key 填回 .env 的 HS_API_KEY
#     5. docker compose up -d panel
#     6. docker compose logs -f panel     # 首次打印管理员账号与口令
#
# ================= 示例 B：对接已有生产 headscale =================
#
#   COMPOSE_FILE=docker-compose.yml
#   PANEL_MASTER_KEY=<openssl rand -hex 32>
#   PANEL_SESSION_SECRET=<openssl rand -hex 32>
#   PANEL_PUBLIC_URL=https://hs-admin.example.com
#   HS_URL=https://hs.example.com
#   HS_API_KEY=<在现有 headscale 上创建>
#   PANEL_BIND=127.0.0.1
#   PANEL_PORT=3000
#   TZ=Asia/Shanghai
#
#   步骤：
#     1. 确认**本机**能访问 HS_URL：
#          curl -sI https://hs.example.com/health | head -1
#     2. 在 headscale 侧建 API Key
#     3. mkdir -p data/dns
#     4. docker compose up -d
#     5. docker compose logs -f panel
#     6. 自测连通性（见「三、」开头的 docker compose exec 命令）
#
#   可选：启用单点登录（面板作 OIDC Provider，headscale 作 Relying Party）
#     1. 面板 → OIDC Provider → 新建客户端，记下 client_id / client_secret
#     2. 改 headscale 的 config.yaml，取消 oidc 段注释并填：
#          issuer:        <PANEL_PUBLIC_URL，必须完全一致>
#          client_id:     <上一步>
#          client_secret: <上一步>
#     3. 重启 headscale。此后 Tailscale 客户端登录走面板账号体系。
#     ⚠️ 顺序不能反：先有面板和客户端，再配 headscale 的 oidc 段。
#        否则 headscale 启动时会去拉 issuer 的 well-known 配置而失败退出。
#
# ================= 示例 C：在示例 B 基础上加时序库 =================
#
#   COMPOSE_FILE=docker-compose.yml:docker-compose.metrics.yml
#   ...（示例 B 的全部内容）...
#   INFLUX_URL=http://influxdb:8181
#   INFLUX_BUCKET=headscale_admin
#   INFLUX_TOKEN=<apiv3_xxx>
#
#   步骤：先按「七、」的三步拿到 token，再 docker compose up -d
