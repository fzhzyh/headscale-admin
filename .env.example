# ============================================================
# headscale-admin 面板环境变量
# 复制为 .env 后按需修改。生产环境务必替换所有 CHANGE_ME。
# ============================================================

# ---------- 面板监听 ----------
# 面板 HTTP 监听地址
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
# 面板对外访问地址（用于 OIDC issuer、回调、Cookie Secure 判定）
# 生产示例：https://panel.example.com
PANEL_PUBLIC_URL=http://127.0.0.1:8080
# 运行环境：development | production
NODE_ENV=development
# 日志级别：trace|debug|info|warn|error
LOG_LEVEL=info

# ---------- 数据目录 ----------
# 面板自己的 SQLite 库与密钥文件所在目录
PANEL_DATA_DIR=./data

# ---------- 加密主密钥 ----------
# 用于 AES-256-GCM 加密落库的 Headscale API Key 等敏感字段。
# 生成方式：openssl rand -base64 32
# 留空则首次启动自动生成到 PANEL_DATA_DIR/master.key（权限 600）
PANEL_MASTER_KEY=
# 会话 JWT 签名密钥（留空自动生成到 PANEL_DATA_DIR/session.key）
PANEL_SESSION_SECRET=

# ---------- 初始管理员 ----------
# 仅当面板用户表为空时用于初始化首个管理员账号（首次启动后立即改密）
PANEL_ADMIN_USER=admin
# 首次启动时写入的初始口令；留空则随机生成并打印到日志
PANEL_ADMIN_SECRET=

# ---------- Headscale 连接（也可登录后在「系统设置」里配）----------
# 传输方式：rest = /api/v1/*（推荐）| grpc = :50443
HS_TRANSPORT=rest
# Headscale REST API 基地址。headscale 的 /api/v1 挂在 listen_addr 上
HS_URL=http://127.0.0.1:18080
# Headscale gRPC 地址（HS_TRANSPORT=grpc 时使用）
HS_GRPC_ADDR=127.0.0.1:50443
# Headscale API Key（headscale apikeys create 生成）。落库后会被加密存储
HS_API_KEY=
# 跳过 TLS 证书校验（自签证书场景；生产不建议）
HS_TLS_SKIP_VERIFY=false
# 连接超时（毫秒）
HS_TIMEOUT_MS=10000

# ---------- extra_records 热加载 ----------
# headscale 配置里 dns.extra_records_path 指向的文件绝对路径。
# 面板写入该文件后，headscale 的 fsnotify 会热加载，无需重启。
# 留空则 DNS 管理写库不落文件（只读模式）
HS_EXTRA_RECORDS_PATH=

# ---------- 时序库（InfluxDB 2.x）----------
# 未配置时自动降级为 SQLite 时序表，面板功能不受影响
INFLUX_URL=
INFLUX_ORG=headscale
INFLUX_BUCKET=headscale_admin
INFLUX_TOKEN=

# ---------- 节点状态采样 ----------
# 采样间隔（秒），决定在线时长统计精度
POLL_INTERVAL_SEC=15
# 是否启用采样器
POLL_ENABLED=true

# ---------- 安全 ----------
# 登录失败锁定：窗口内最大失败次数
LOGIN_MAX_FAILURES=5
# 锁定时长（秒）
LOGIN_LOCKOUT_SEC=900
# 会话有效期（秒），默认 12 小时
SESSION_TTL_SEC=43200
# 是否强制写操作校验 CSRF Token（生产必须 true）
CSRF_ENABLED=true

# ============================================================
# 以下为 **docker compose 生产部署** 额外需要的变量
# ============================================================
#
# ⚠️ 生产部署必须填写 PANEL_MASTER_KEY / PANEL_SESSION_SECRET / HS_API_KEY
#    三项（compose 里用 ${VAR:?} 做了缺失即失败的校验，不会静默用默认值）。
#    生成：openssl rand -hex 32
#
# ⚠️ PANEL_PUBLIC_URL 必须与浏览器实际访问地址**完全一致**（协议+域名+端口），
#    它会作为内置 OIDC Provider 的 issuer；不一致会导致 headscale 侧 iss 校验失败。

# ---------- 镜像与构建 ----------
# 本地构建的镜像名；也可指向已推送的镜像仓库地址
PANEL_IMAGE=headscale-admin:latest
# 基础镜像与 npm 源。国内网络改成：
#   NODE_IMAGE=docker.m.daocloud.io/library/node
#   NPM_REGISTRY=https://registry.npmmirror.com
NODE_IMAGE=node:22-alpine
NPM_REGISTRY=https://registry.npmjs.org
# 留空 = 沿用 package.json 里的版本（发版后构建即真版本），推荐留空。
# 仅在 CI 需要用 tag 强制对齐时才填，例如 PANEL_VERSION=1.0.1
PANEL_VERSION=

# ---------- 端口绑定 ----------
# 默认只绑本机回环，由前面 nginx/Caddy 对外提供 TLS。
# 直接对外请改成 0.0.0.0，但**务必**同时配置 TLS（http 会明文传口令）
PANEL_BIND=127.0.0.1
HS_BIND=127.0.0.1
INFLUX_BIND=127.0.0.1

# ---------- Headscale 容器（如已有实例，删掉 compose 里的 headscale 服务）----------
HEADSCALE_IMAGE=headscale/headscale:v0.29.6

# 宿主端口（容器内固定 8080）。
# 实测踩过：宿主上 8080 常被别的服务占着 → `Bind for 0.0.0.0:8080 failed:
# port is already allocated`，headscale 起不来。冲突时改这里。
HS_PORT=8080

# ---------- DNS extra-records（可选）----------
# 面板写、headscale 读的共享目录（compose 里两边都挂 /dns）
DNS_RECORDS_DIR=./data/dns

# ---------- InfluxDB（可选）----------
# 启用方式：docker compose --profile metrics up -d
# 不启用时面板降级为「无时序库」，核心功能不受影响
INFLUX_IMAGE=influxdb:2.7-alpine
INFLUX_ADMIN_USER=admin
# 生成：openssl rand -base64 24（启用 metrics profile 时必填）
INFLUX_ADMIN_PASSWORD=

# ---------- 时区 ----------
TZ=Asia/Shanghai

